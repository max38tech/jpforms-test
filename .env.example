NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Optional: fallback defaults for Gemini model ids, used only until an
# admin sets them live in Admin -> System & LLM Settings. Google retires
# Gemini model ids periodically (e.g. gemini-2.0-flash and
# text-embedding-004 were both shut down) — if chat/extraction suddenly
# 404s, update these or just change it live in the admin UI, no redeploy.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_SCHEMA_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: fallback default for the Custom/OpenAI-compatible vision
# provider option for schema extraction (e.g. Qwen3.7-Flash via QwenCloud/
# DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
SCHEMA_CUSTOM_BASE_URL=
SCHEMA_CUSTOM_MODEL=qwen3.7-flash
SCHEMA_CUSTOM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: only used as a fallback default for the chatbot's Custom /
# open-source provider before an admin configures one in /admin/settings.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# Stripe — required for the payment gate on form downloads (one-time
# per-page purchase or weekly subscription). Get keys from
# https://dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you create in the Stripe dashboard pointing at
# <your-site>/api/billing/webhook (listen for checkout.session.completed,
# invoice.paid, customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=whsec_...
# Used to build Stripe success/cancel redirect URLs server-side as a
# fallback when the request Origin header isn't available.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
